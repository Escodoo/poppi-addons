<odoo>
    <!-- pylint:disable=xml-dangerous-qweb-replace-low-priority -->
    <template
        id="poppi_inherit_invoice_report"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//div[contains(@class, 'page')]" position="attributes">
            <attribute name="style">font-size: 12px !important;</attribute>
            <attribute name="t-foreach">o.financial_move_line_ids</attribute>
            <attribute name="t-as">current_installment</attribute>
            <attribute
                name="t-att-data-installment-index"
            >current_installment_index</attribute>
        </xpath>

        <!-- Hide the "Taxes" column in the header -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-attf-class">d-none</attribute>
        </xpath>
        <!-- Hide the "Taxes" column in the table body -->
        <xpath expr="//td[span[@id='line_tax_ids']]" position="attributes">
            <attribute name="t-attf-class">d-none</attribute>
        </xpath>
        <!-- Remove the loop that displays taxes after the Subtotal -->
        <xpath expr="//t[@t-as='amount_by_group']" position="replace">
        </xpath>
        <!-- Add the Fiscal Document Number before the Invoice -->
        <xpath expr="//div[@class='page']/h2" position="before">
            <div t-if="o.document_number">
                <h3>
                    <span>Document Number: </span>
                    <span t-field="o.document_number" />
                </h3>
            </div>
        </xpath>

        <xpath expr="//div[@class='page']/h2" position="replace">
            <h2>
                <span>Installment </span>
                <span t-esc="current_installment_index + 1" /> / <span
                    t-esc="len(o.financial_move_line_ids)"
                />
            </h2>
        </xpath>
        <xpath expr="//div[@name='due_date']" position="replace">
            <div class="col-auto col-3 mw-100 mb-2" name="due_date">
                <strong>Due Date:</strong>
                <p
                    class="m-0"
                    t-esc="current_installment.date_maturity"
                    t-options="{'widget': 'date'}"
                />
            </div>
        </xpath>
        <xpath expr="//div[@class='page']" position="inside">
            <p style="page-break-after: always;" />
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <t t-set="installment_number" t-value="0" />
            <table class="table table-sm o_main_table" name="installments_table">
                <thead>
                    <tr>
                        <th>Installment</th>
                        <th>Due Date</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.financial_move_line_ids" t-as="installment">
                        <t
                            t-set="installment_number"
                            t-value="installment_number + 1"
                        />
                        <tr>
                            <td
                                t-att-style="'font-weight: bold;' if installment == current_installment else ''"
                            >
                                <span t-esc="installment_number" /> / <span
                                    t-esc="len(o.financial_move_line_ids)"
                                />
                            </td>
                            <td
                                t-att-style="'font-weight: bold;' if installment == current_installment else ''"
                            >
                                <span
                                    t-field="installment.date_maturity"
                                    t-options="{'widget': 'date'}"
                                />
                            </td>
                           <td
                                t-att-style="'font-weight: bold;' if installment == current_installment else ''"
                            >
                                <span
                                    t-esc="abs(installment.amount_currency)"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
