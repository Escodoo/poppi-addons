<odoo>
    <!-- pylint:disable=xml-dangerous-qweb-replace-low-priority -->
    <template
        id="poppi_inherit_invoice_report"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//div[hasclass('page')]" position="before">
            <t
                t-set="installments"
                t-value="o.line_ids.filtered(lambda line: line.display_type == 'payment_term').sorted('date_maturity')"
            />
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="t-foreach">installments or [False]</attribute>
            <attribute name="t-as">current_installment</attribute>
            <attribute
                name="t-att-style"
            >('font-size: 12px;' + (' page-break-before: always;' if current_installment_index else '')) if current_installment else None</attribute>
        </xpath>

        <!-- Keep one external layout article per invoice for Odoo's PDF splitting. -->
        <xpath expr="//t[@t-set='layout_document_title']" position="attributes">
            <attribute name="t-if">not current_installment</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="o.document_number" name="poppi_document_number">
                <h3>
                    <span>Document Number:</span>
                    <span t-field="o.document_number" />
                </h3>
            </div>
            <h2 t-if="current_installment" name="poppi_installment_title">
                <span>Installment </span>
                <span t-out="current_installment_index + 1" /> / <span
                    t-out="len(installments)"
                />
            </h2>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if" add="current_installment" separator=" or " />
        </xpath>
        <xpath expr="//div[@name='due_date']" position="before">
            <div class="col" t-if="current_installment" name="poppi_due_date">
                <strong>Due Date:</strong>
                <div t-field="current_installment.date_maturity" />
            </div>
        </xpath>
        <xpath expr="//div[@name='due_date']" position="attributes">
            <attribute
                name="t-if"
            >not current_installment and o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'</attribute>
        </xpath>

        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">not current_installment</attribute>
        </xpath>
        <xpath expr="//td[span[@id='line_tax_ids']]" position="attributes">
            <attribute name="t-if">not current_installment</attribute>
        </xpath>
        <xpath
            expr="//t[@t-call='account.document_tax_totals']/t[@t-set='tax_totals']"
            position="attributes"
        >
            <attribute
                name="t-value"
            >dict(o.tax_totals, subtotals=[dict(subtotal, tax_groups=[]) for subtotal in o.tax_totals['subtotals']]) if current_installment else o.tax_totals</attribute>
        </xpath>
        <xpath
            expr="//t[t[@t-call='account.document_tax_totals_company_currency_template']]"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not current_installment and o.tax_totals.get('display_in_company_currency')</attribute>
        </xpath>

        <xpath expr="//t[@t-foreach='payment_term_details']" position="attributes">
            <attribute name="t-if" add="not current_installment" separator=" and " />
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <table
                t-if="current_installment"
                class="table table-sm o_main_table"
                name="installments_table"
            >
                <thead>
                    <tr>
                        <th>Installment</th>
                        <th>Due Date</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr
                        t-foreach="installments"
                        t-as="installment"
                        t-att-style="'font-weight: bold;' if installment == current_installment else None"
                    >
                        <td>
                            <span t-out="installment_index + 1" /> / <span
                                t-out="len(installments)"
                            />
                        </td>
                        <td><span t-field="installment.date_maturity" /></td>
                        <td>
                            <span
                                t-out="abs(installment.amount_currency)"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                            />
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
