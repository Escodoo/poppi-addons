<odoo>

    <record id="view_product_template_compensation_form" model="ir.ui.view">
        <field name="name">product.template.compensation.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page name="fiscal_compensation" string="Fiscal Compensation">
                    <group>
                        <field
                            name="compensation_value"
                            class="oe_inline"
                            widget='monetary'
                            options="{'currency_field': 'currency_id', 'field_digits': True}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
